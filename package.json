{
  "name": "vedaai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "start:backend": "npm run start --workspace=apps/backend",
    "start:frontend": "npm run start --workspace=apps/frontend",
    "install:all": "npm install",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "BACKEND_PORT=4001 PORT=4001 npm run start:backend & npm run start:frontend -- -p 3000 & BACKEND_PORT=4001 node server.js",
    "verify": "node verify_connections.js"
  },
  "dependencies": {
    "http-proxy": "^1.18.1"
  }
}
